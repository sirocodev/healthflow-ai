# 이 파일을 복사해서 .env.local 로 이름 바꾸고 실제 값을 채워넣으세요.
# .env.local은 .gitignore에 있어서 깃허브에 절대 올라가지 않습니다.

# Supabase 프로젝트 설정 > API 에서 확인
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key

# 세션 쿠키 서명용 — 아무 랜덤 문자열이나 (터미널에서: openssl rand -hex 32)
SESSION_SIGNING_SECRET=여기에_랜덤한_긴_문자열

# Anthropic API 키 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=여기에_anthropic_api_key
